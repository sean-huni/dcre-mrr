             and every environment that migrated at a different time holds a different
             one, so a pin is correct on exactly one database and silently wrong on the
             rest. The preConditions block is what keeps the re-run safe; the checksum
             is not load-bearing here. Same call, same reason, as prr 002-batch-metadata. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="MRR_BATCH_JOB_EXECUTION"/></not>
        </preConditions>
        <createTable tableName="MRR_BATCH_JOB_EXECUTION">
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="BIGINT"/>
            <column name="JOB_INSTANCE_ID" type="BIGINT"><constraints nullable="false"/></column>
            <column name="CREATE_TIME" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="START_TIME" type="TIMESTAMP"/>
            <column name="END_TIME" type="TIMESTAMP"/>
            <column name="STATUS" type="VARCHAR(10)"/>
            <column name="EXIT_CODE" type="VARCHAR(2500)"/>
            <!-- TEXT, not VARCHAR(2500): a truncated CockroachDB cause chain is unreadable. -->
            <column name="EXIT_MESSAGE" type="TEXT"/>
            <column name="LAST_UPDATED" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint constraintName="JOB_INST_EXEC_FK"
                                 baseTableName="MRR_BATCH_JOB_EXECUTION" baseColumnNames="JOB_INSTANCE_ID"
                                 referencedTableName="MRR_BATCH_JOB_INSTANCE" referencedColumnNames="JOB_INSTANCE_ID"/>
    </changeSet>

